# renv pins the exact package versions used to produce the results in this
# compendium. To set it up once, from the compendium root:
#
#   install.packages("renv")
#   renv::init()          # writes renv.lock (commit it) and renv/activate.R
#
# After renv::init(), this file activates the project library automatically on
# every R session started here. cmdstan itself is installed separately with
# cmdstanr::install_cmdstan() and its version should be recorded in the README.
if (file.exists("renv/activate.R")) source("renv/activate.R")
